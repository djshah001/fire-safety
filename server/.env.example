NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/fire_safety
BUSINESS_TIMEZONE=Asia/Kolkata
UPLOAD_ROOT=./uploads
LOG_LEVEL=info
SESSION_TTL_HOURS=12
PASSWORD_RESET_TTL_MINUTES=60
# disabled | local-file (development/test only) | smtp
MAIL_DELIVERY_MODE=local-file
LOCAL_MAILBOX_ROOT=./.local/mailbox
# Required when MAIL_DELIVERY_MODE=smtp. Credentials are optional only for trusted relay servers.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# false requires STARTTLS; true uses implicit TLS.
# SMTP_SECURE=false
# SMTP_USER=replace_me
# SMTP_PASSWORD=replace_me
# SMTP_FROM=notifications@example.com

# Optional override used only by `npm run seed:demo` (minimum 12 characters).
# DEMO_SEED_PASSWORD=replace_with_a_local_demo_password

# Required only when running `npm run bootstrap:admin --workspace @fire-safety/server`.
BOOTSTRAP_COMPANY_NAME=Fire Safety
BOOTSTRAP_BRANCH_NAME=Main Branch
BOOTSTRAP_ADMIN_NAME=Local Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_unique_local_password
